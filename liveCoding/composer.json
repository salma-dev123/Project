{
  "name": "salma/convertisseur",
  "description": "Convertisseur décimal -> binaire/hex + batch processing CLI",
  "type": "project",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "start": "php bin/convert.php",
